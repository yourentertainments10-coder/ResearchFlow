{
  // Cloudflare static-site deploy: serves the dashboard in ./site. No server code, no build step.
  "name": "researchflow",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./site" },
  // `wrangler preview` (Workers Builds, non-production branches) requires this block to exist. Empty on
  // purpose: assets and compatibility settings stay top-level, and there are no bindings or variables to
  // diverge. Production (`wrangler deploy`) ignores it.
  "previews": {}
}
