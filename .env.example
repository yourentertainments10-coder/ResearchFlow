# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Local development (docker compose up -d db):
DATABASE_URL=postgresql://sie:sie@localhost:5432/sie
# Render / Neon / Supabase give you a URL like postgresql://user:pass@host/db?sslmode=require
# (postgres:// and postgresql:// are both accepted and converted to the psycopg driver form)

DATA_DIR=data
COMPETITION_ID=asiad-2026
HTTP_USER_AGENT=SIE-research/0.1 (contact: you@example.com)
HTTP_MIN_INTERVAL_SECONDS=2
HTTP_TIMEOUT_SECONDS=30
PORTAL_FETCH_ENABLED=false   # true allows `sie scheduled-run portal`; needs a real HTTP_USER_AGENT contact (ADR-031)
SOURCE_PRIORITY=official,manual
RAW_STORE_BACKEND=fs   # fs: files under DATA_DIR/raw, db: gzip bytes in the raw_blobs table
FRESHNESS_THRESHOLD_MINUTES=30
LOG_LEVEL=INFO
PG_BIN_DIR=             # folder holding pg_dump/pg_restore if not on PATH (client must not be older than the server)
ALERT_STATE_PATH=       # default DATA_DIR/alert_state.json; must be on durable storage
ALERT_RENOTIFY_MINUTES=0  # 0 = send each alert once until it resolves

# Passwords for the least-privilege roles, used once by `sie db-roles` (min 16 characters).
# Then give the dashboard a URL for sie_reader and scheduled runs a URL for sie_pipeline.
SIE_READER_PASSWORD=
SIE_PIPELINE_PASSWORD=

# Optional
LLM_API_KEY=
NOTIFY_WEBHOOK_URL=
